# Placeholder-only local development configuration. Never commit real credentials.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://synthetic_user:synthetic_password@localhost:26257/quantitative_survey?sslmode=disable
# Used only by Prisma migration commands. Keep this option off DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://synthetic_migration_user:synthetic_migration_password@localhost:26257/quantitative_survey?sslmode=disable&options=-c%20create_table_with_schema_locked%3Doff
BETTER_AUTH_SECRET=replace-with-a-local-only-secret-at-least-32-characters
PII_ENCRYPTION_ACTIVE_VERSION=1
PII_ENCRYPTION_KEY_V1=replace-with-base64-encoded-32-byte-key
PHONE_LOOKUP_HMAC_ACTIVE_VERSION=1
PHONE_LOOKUP_HMAC_KEY_V1=replace-with-a-different-base64-encoded-32-byte-key
RATE_LIMIT_HMAC_KEY=replace-with-a-third-base64-encoded-32-byte-key
MAIL_TRANSPORT=local-file
LOCAL_MAILBOX_PATH=/tmp/qsp-local-password-reset-mailbox.jsonl
# Preview/production must use MAIL_TRANSPORT=resend with deployment secrets.
# RESEND_API_KEY=replace-with-resend-api-key
# RESEND_FROM_EMAIL=Survey Platform <no-reply@example.com>
# BACKUP_ENCRYPTION_KEY is intentionally absent: it stays outside app runtime.
LOG_LEVEL=info
# Required in preview/production for the authenticated dependency smoke check.
# QSP_SMOKE_TOKEN=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_APP_NAME=Quantitative Survey Platform
